<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<OutputType>Library</OutputType>
		<Product>Corsinvest for Proxmox VE Node Protect Api</Product>
		<AssemblyTitle>Corsinvest for Proxmox VE Node Protect Api</AssemblyTitle>
		<Description>Node Protect API library for Proxmox VE: backup of node configuration files via SSH</Description>
		<PackageTags>ProxmoxVE;Proxmox;Backup;Configuration;SSH;Node;Protection;Cluster;Api;Client;Rest;Corsinvest</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<!-- Local test feed: every build drops the package in ProxmoxVE\.nupkgs -->
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageOutputPath>..\..\..\.nupkgs\</PackageOutputPath>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>

		<!-- Symbols: PDB inside the .nupkg (local debugging) and .snupkg for nuget.org -->
		<AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\icon.png" Pack="true" PackagePath="" />
		<None Include="..\..\README.md" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Corsinvest.ProxmoxVE.Api.Extension" />
		<PackageReference Include="SSH.NET" />
	</ItemGroup>
</Project>